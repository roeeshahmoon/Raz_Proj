@page "/"
@using Microsoft.AspNetCore.Components
@inject NavigationManager Nav


<PageTitle>Home</PageTitle>

<div class="home-container text-center d-flex flex-column justify-content-center align-items-center vh-100">
    <h1 class="display-3 fw-bold text-primary mb-3 animate-fade">Welcome to Raz Shahmoon Game Project 🎉</h1>
    <p class="lead text-muted mb-4">This is my Blazor app – built with My ❤ Brother and C#.</p>

    <div class="card shadow-lg p-4 mb-4 bg-light rounded-4 w-75">
        <p class="mb-3 fs-5">Use the navigation menu to:</p>
        <ul class="list-unstyled mb-4">
            <li>🔐 <strong>Login</strong> to your account</li>
            <li>📝 <strong>Register</strong> as a new user</li>
            <li>🎮 <strong>Play the game!</strong></li>
            <li>👥 <strong>Users</strong> played the game</li>


        </ul>
        <div class="d-flex flex-column align-items-center">
            <button class="reset-button btn btn-success" @onclick="LoginPage">🔐 Login</button>
            <button class="back-home btn btn-outline-primary" @onclick="RegisterPage">📝 Register</button>
            <button class="back-home btn btn-outline-primary" @onclick="PlayPage">🎮 Play Game</button>
            <button class="back-home btn btn-outline-primary" @onclick="UserPage">👥 Users </button>
        </div>
    </div>

    <div class="card shadow-lg p-3 bg-white rounded-4 w-50 mt-3" style="max-width: 500px;">
        <div class="row g-2 align-items-center">
            <div class="col-4">
                <img src="Images/raz.jpeg" alt="Raz Shahmoon" class="img-fluid rounded-4 shadow-sm" style="max-width: 250px;" />
            </div>
            <div class="col-8 text-start">
                <h5 class="fw-bold text-primary mb-2">Meet Raz Shahmoon</h5>
                <p class="fs-6 mb-0">
                    Raz is 16 years old and lives in Tel Aviv. He's a big fan of Maccabi Tel Aviv and loves programming.
                    He studies at Tichonnet High School and enjoys building cool apps like this one.
                </p>
            </div>
        </div>
    </div>


</div>

@code{

    private void LoginPage()
    {
        Nav.NavigateTo("/login");
    }

    private void RegisterPage()
    {
        Nav.NavigateTo("/register");
    }

    private void PlayPage()
    {
        Nav.NavigateTo("/game");
    }

    private void UserPage()
    {
        Nav.NavigateTo("/users");
    }


}
